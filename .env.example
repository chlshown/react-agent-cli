# ---- LLM（任何 OpenAI 兼容端点均可：DeepSeek / 通义 / Moonshot / OpenAI）----
# DeepSeek 示例：
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=sk-xxx
AI_MODEL=deepseek-chat
# OpenAI 官方则用：
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# ---- 搜索工具（Tavily，https://tavily.com 免费额度 1000 次/月）----
TAVILY_API_KEY=tvly-xxx

# Agent 单次任务最大步数（防失控循环）
MAX_STEPS=8
