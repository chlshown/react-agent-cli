# ---- LLM（任何 OpenAI 兼容端点均可：通义千问 / DeepSeek / Moonshot / OpenAI）----
# 通义千问示例（当前 .env 采用）：
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_API_KEY=sk-xxx
AI_MODEL=qwen-plus
# DeepSeek 则用：
# AI_BASE_URL=https://api.deepseek.com/v1
# AI_MODEL=deepseek-chat

# ---- 搜索工具（Tavily，https://tavily.com 免费额度 1000 次/月）----
TAVILY_API_KEY=tvly-xxx

# Agent 单次任务最大步数（防失控循环）
MAX_STEPS=8
